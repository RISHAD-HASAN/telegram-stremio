# ==============================================================================
# Telegram-Stremio Ultimate - Configuration File
# Copy this file to config.env and fill in your details.
# ==============================================================================

# Telegram API credentials (from https://my.telegram.org)
API_ID=""
API_HASH=""

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=""

# Owner User ID (get numeric ID from @userinfobot)
OWNER_ID=""

# MongoDB Databases (required: exactly 2 comma-separated URIs)
# Local MongoDB: "mongodb://localhost:27017/tracking,mongodb://localhost:27017/storage1"
# MongoDB Atlas: "mongodb+srv://user:pass@cluster.mongodb.net/tracking,mongodb+srv://user:pass@cluster.mongodb.net/storage1"
DATABASE="mongodb://localhost:27017/tracking,mongodb://localhost:27017/storage1"

# Web Server Port
PORT="8000"

# Base URL (e.g. http://127.0.0.1:8000 or http://192.168.1.50:8000)
BASE_URL="http://127.0.0.1:8000"

# Optional: Initial Auth Channel ID (numeric ID, e.g. 1234567890 or -1001234567890)
AUTH_CHANNEL=""

# Optional: Duplicate & Replace Behavior (default: keep all files, skip duplicates, never delete)
REPLACE_MODE="false"
DUPLICATE_PROTECTION="true"

# Optional: TMDB API Key (for metadata lookups)
TMDB_API=""

# Optional: Telegram User Session String (for downloading from private/restricted channels & 2GB+ files)
USER_SESSION_STRING=""

