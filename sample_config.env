# Telegram Stremio configuration
#
# Copy this file to config.env and fill in the required block.
# Values in the environment take precedence over this file.

# ---------------------------------------------------------------------------
# Required: the server does not start without these
# ---------------------------------------------------------------------------

# Telegram API credentials from https://my.telegram.org (API development tools)
API_ID=""
API_HASH=""

# Bot token from @BotFather
BOT_TOKEN=""

# Two MongoDB URIs separated by a comma: the tracking database first, then a
# storage database. More storage URIs can follow, or be added later in Settings.
# Local:  "mongodb://localhost:27017/tracking,mongodb://localhost:27017/storage1"
# Atlas:  "mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/,mongodb+srv://USER:PASSWORD@cluster2.example.mongodb.net/"
DATABASE=""

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------

# Your numeric Telegram user ID (ask @userinfobot). The owner may use the bot
# commands; without it nobody can.
OWNER_ID=""

# Port of the web server (default 8000)
PORT="8000"

# Time zone of log lines and bot messages, as an IANA name such as
# "Europe/Berlin" or "Asia/Dhaka" (default "Asia/Kolkata")
TIMEZONE=""

# ---------------------------------------------------------------------------
# Optional first-start values
#
# These are copied into the database the first time the server starts. After
# that the Settings page of the web panel is the place to change them, and
# editing them here has no effect.
# ---------------------------------------------------------------------------

# Address under which this server is reachable from your players, without a
# trailing slash. Use the public https address when the server is online.
BASE_URL="http://127.0.0.1:8000"

# Login for the web panel. The default is admin / admin: change it here before
# the first start, or under Settings afterwards.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# Channels the bot indexes, as numeric IDs separated by commas
# (for example "-1001234567890,-1009876543210")
AUTH_CHANNEL=""

# Metadata API keys. Without them the server uses the free providers
# (Cinemeta, Kitsu), so both are optional.
TMDB_API=""
TVDB_API=""

# Replace Mode: a new file for the same title and resolution replaces the
# older one when it is better, and the old post is deleted from the channel.
REPLACE_MODE="false"

# With Replace Mode off: skip a file that is already indexed.
DUPLICATE_PROTECTION="true"

# Hide the automatic catalogs in Stremio
HIDE_CATALOG="false"

# Update source for the Restart button and the Docker start script: a git
# repository URL and branch. Leave empty to keep the installed code.
UPSTREAM_REPO=""
UPSTREAM_BRANCH=""

# Subscription system: users need an approved plan to get a token
SUBSCRIPTION="false"
SUBSCRIPTION_GROUP_ID=""
# Telegram user IDs allowed to approve subscriptions, separated by commas
APPROVER_IDS=""

# Route stream links through an HTTP proxy
HTTP_Proxy_URL=""
SHOW_ProxyAndNonProxyBoth="false"

# Login for the read-only WebDAV share
WEBDAV_USER=""
WEBDAV_PASSWORD=""
